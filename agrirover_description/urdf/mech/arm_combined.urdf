<?xml version="1.0" ?>
<robot name="agrirover">
  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Base_simplified.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
  <link name="arm_link_0">
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Link_0.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Link_0_simplified.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
  <link name="arm_link_1">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
  <link name="arm_link_2">
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/Link_2_simplified.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <link name="world">
  </link>
  
  <link name="gripper">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/gripper.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/gripper_simplified.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="finger_1">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="finger_2">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="finger_3">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_link_0" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link_0"/>
    <origin xyz="0 0 0.03" rpy="0 0 3.14"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="1.0" lower="0" upper="3.14"/>
  </joint>
  <joint name="link_0_to_link_1" type="revolute">
    <parent link="arm_link_0"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0.05" rpy="1.57 -1.57 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10.0" velocity="1.0" lower="0" upper="3.14"/>
  </joint>
  <joint name="link_1_to_link_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0 0.176 0" rpy="0 0 1.57"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10.0" velocity="1.0" lower="0" upper="3.14"/>
  </joint>
  <joint name="link_2_to_gripper" type="revolute">
    <parent link="arm_link_2"/>
    <child link="gripper"/>
    <origin xyz="0 0.155 0" rpy="0 0 -1.57"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="1.0" lower="0" upper="3.14"/>
  </joint>
  <joint name="finger_1_joint" type="revolute">
    <parent link="gripper"/>
    <child link="finger_1"/>
    <origin xyz="0.02 0.08 -0.001" rpy="3.14 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="1.0" lower="0" upper="0.9"/>
  </joint>
  <joint name="finger_2_joint" type="fixed">
    <parent link="gripper"/>
    <child link="finger_2"/>
    <origin xyz="-0.0085 0.08 0.015" rpy="3.14 -2.0944 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="finger_3_joint" type="fixed">
    <parent link="gripper"/>
    <child link="finger_3"/>
    <origin xyz="-0.0085 0.08 -0.015" rpy="3.14 2.0944 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="camera_head_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0.0 1.5707963267948966"/>
      <geometry>
        <mesh filename="package://agrirover_description/meshes/d435/visual/d435.stl"/>
      </geometry>
      <material name="aluminum">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02505 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <joint name="camera_head_depth_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="camera_head_link"/>
    <child link="camera_head_depth_frame"/>
  </joint>
  <link name="camera_head_depth_frame"/>
  <joint name="camera_head_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="camera_head_depth_frame"/>
    <child link="camera_head_depth_optical_frame"/>
  </joint>
  <link name="camera_head_depth_optical_frame"/>
  <joint name="camera_head_infra1_joint" type="fixed">
    <origin xyz="0 0.0 0" rpy="0 0 0"/>
    <parent link="camera_head_link"/>
    <child link="camera_head_infra1_frame"/>
  </joint>
  <link name="camera_head_infra1_frame"/>
  <joint name="camera_head_infra1_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="camera_head_infra1_frame"/>
    <child link="camera_head_infra1_optical_frame"/>
  </joint>
  <link name="camera_head_infra1_optical_frame"/>
  <joint name="camera_head_infra2_joint" type="fixed">
    <origin xyz="0 -0.050 0" rpy="0 0 0"/>
    <parent link="camera_head_link"/>
    <child link="camera_head_infra2_frame"/>
  </joint>
  <link name="camera_head_infra2_frame"/>
  <joint name="camera_head_infra2_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="camera_head_infra2_frame"/>
    <child link="camera_head_infra2_optical_frame"/>
  </joint>
  <link name="camera_head_infra2_optical_frame"/>
  <joint name="camera_head_color_joint" type="fixed">
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
    <parent link="camera_head_link"/>
    <child link="camera_head_color_frame"/>
  </joint>
  <link name="camera_head_color_frame"/>
  <joint name="camera_head_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="camera_head_color_frame"/>
    <child link="camera_head_color_optical_frame"/>
  </joint>
  <link name="camera_head_color_optical_frame"/>
  <gazebo reference="camera_head_link">
    <sensor name="camera_head" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>424</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>1.5</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <gz_frame_id>camera_head_link</gz_frame_id>
      <topic>camera_head</topic>
      <update_rate>5</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <joint name="gripper_to_camera" type="fixed">
    <parent link="gripper"/>
    <child link="camera_head_link"/>
    <origin xyz="-0.025 0.02 0" rpy="-1.57 0 1.57"/>
  </joint>



</robot>